{
  "name": "example-notes-app",
  "stack": [
    "react-native-expo"
  ],
  "checklists": [
    "general",
    "security"
  ],
  "stores": [],
  "riskyAreas": [
    "delete account",
    "anything that sums money",
    "backend rules"
  ],
  "ignore": [],
  "design": {
    "goal": "A notes app for one person, synced through Firestore.",
    "scale": {
      "usersNow": 10,
      "users12Months": 1000,
      "recordsPerUser": 500
    },
    "budget": "free tiers only",
    "platforms": [
      "ios"
    ],
    "team": "solo developer",
    "mustNeverHappen": [
      "lose a user's data",
      "show a wrong total"
    ],
    "next": [
      "feature one",
      "feature two"
    ],
    "constraints": [],
    "decided": []
  },
  "data": {
    "store": "firestore",
    "modelFiles": [
      "src/types.ts"
    ],
    "rulesFile": "firestore.rules",
    "accessFiles": [
      "src/store.ts"
    ]
  },
  "structure": {
    "roots": ["src", "App.tsx"],
    "extra": [],
    "ignore": ["tests"],
    "layers": [
      { "name": "shared", "paths": ["src/shared"], "mayImport": [] },
      { "name": "data", "paths": ["src/data"], "mayImport": ["shared"] },
      { "name": "components", "paths": ["src/components"], "mayImport": ["shared"] },
      { "name": "screens", "paths": ["src/screens"], "mayImport": ["shared", "data", "components"] }
    ],
    "restricted": [{ "module": "firebase", "onlyIn": ["src/data"] }],
    "gate": ["cycles", "layers", "restricted"],
    "duplicates": { "minLines": 6, "minChars": 120 },
    "repeated": { "minFiles": 3, "ignore": [] },
    "size": { "maxFileLines": 300, "maxFunctionLines": 80 }
  },
  "release": {
    "appConfig": "app.json",
    "privacyFile": "public/privacy.html",
    "lockfileCommand": "npm ci --dry-run --ignore-scripts",
    "gate": ["lockfile", "appConfig", "permissions", "tracked"]
  },
  "tests": { "paths": ["tests"], "risky": ["src/data", "src/notify"], "gate": [] },
  "commands": [
    {
      "name": "types",
      "run": "npx tsc --noEmit"
    }
  ],
  "forbidden": [
    {
      "name": "console.log",
      "pattern": "console\\.log\\(",
      "paths": [
        "src",
        "App.tsx"
      ]
    },
    {
      "name": "TODO/FIXME",
      "pattern": "TODO|FIXME",
      "paths": [
        "src",
        "App.tsx"
      ]
    }
  ],
  "secrets": {
    "paths": [
      "."
    ],
    "skip": [
      "node_modules",
      ".git",
      "dist",
      "package-lock.json"
    ]
  }
}
