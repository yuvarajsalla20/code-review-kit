{
  "name": "my-app",
  "timezone": "America/Chicago",
  "stack": ["react-native-expo"],
  "checklists": ["general", "security", "deep-links", "widgets"],
  "stores": [],
  "riskyAreas": [
    "delete account",
    "anything that sums money",
    "backend rules"
  ],
  "ignore": [],
  "failurePaths": [
    "Project-specific traps for the failure-paths pass, e.g. a second device on the same account"
  ],
  "design": {
    "kind": "app",
    "goal": "One or two sentences: what it does and for whom.",
    "scale": { "usersNow": 10, "users12Months": 1000, "recordsPerUser": 500 },
    "budget": "free tiers only",
    "platforms": ["ios"],
    "team": "solo developer",
    "mustNeverHappen": ["lose a user's data", "show a wrong total"],
    "next": ["feature one", "feature two"],
    "constraints": [],
    "decided": []
  },
  "data": {
    "store": "firestore",
    "modelFiles": ["src/types.ts"],
    "rulesFile": "firestore.rules",
    "accessFiles": ["src/store.ts"]
  },
  "structure": {
    "roots": ["src", "App.tsx"],
    "extra": [],
    "ignore": ["tests"],
    "layers": [
      { "name": "shared", "paths": ["src/shared"], "mayImport": [] },
      { "name": "data", "paths": ["src/data"], "mayImport": ["shared"] },
      { "name": "components", "paths": ["src/components"], "mayImport": ["shared"] },
      { "name": "screens", "paths": ["src/screens"], "mayImport": ["shared", "data", "components"] }
    ],
    "restricted": [{ "module": "firebase", "onlyIn": ["src/data"] }],
    "gate": ["cycles", "layers", "restricted"],
    "duplicates": { "minLines": 6, "minChars": 120 },
    "repeated": { "minFiles": 3, "ignore": [] },
    "size": { "maxFileLines": 300, "maxFunctionLines": 80 }
  },
  "release": {
    "appConfig": "app.json",
    "privacyFile": "public/privacy.html",
    "lockfileCommand": "npm ci --dry-run --ignore-scripts",
    "keyPrefixes": { "EXPO_PUBLIC_RC_IOS_KEY": "appl_" },
    "productionProfiles": ["production"],
    "gate": ["lockfile", "appConfig", "permissions", "tracked", "storeKeys"]
  },
  "tests": { "paths": ["tests"], "risky": ["src/data", "src/notify"], "gate": [] },
  "speed": { "roots": ["src", "App.tsx"], "assetRoots": ["assets"], "webRoots": ["public"], "maxAssetKb": 300, "gate": [] },
  "links": { "roots": ["src", "App.tsx"], "ignore": ["tests"], "gate": [] },
  "widgets": { "roots": ["src", "App.tsx"], "ignore": ["tests"], "gate": [] },
  "skipAreas": { "agents": "Example: say why an area does not apply. A skip with no reason counts as not run." },
  "firestoreLoad": {
    "rules": "firestore.rules",
    "projectId": "demo-my-app",
    "owner": "users/{uid}",
    "items": "users/{uid}/items",
    "ownerRequired": true,
    "eraseOrder": "ownerFirst",
    "profile": { "email": null },
    "item": { "name": "Example", "updatedAt": "" },
    "idField": "id",
    "newerField": "updatedAt",
    "invalid": [{ "label": "a name over 120 characters", "patch": { "name": "repeat:x:121" } }],
    "users": 300,
    "perUser": 20,
    "heavy": 2000
  },
  "e2e": {
    "appId": "com.example.app",
    "firstScreen": "Sign In",
    "signIn": { "button": "Sign In", "email": "Email", "password": "Password", "done": "Home" },
    "add": { "open": "Add", "field": "Name", "save": "Save" },
    "links": [{ "url": "myapp://item/123", "expect": "Home" }],
    "back": "Close"
  },
  "commands": [
    { "name": "types", "run": "npx tsc --noEmit" }
  ],
  "forbidden": [
    { "name": "console.log", "pattern": "console\\.log\\(", "paths": ["src", "App.tsx"] },
    { "name": "TODO/FIXME", "pattern": "TODO|FIXME", "paths": ["src", "App.tsx"] }
  ],
  "secrets": { "paths": ["."], "skip": ["node_modules", ".git", "dist", "package-lock.json"] }
}
